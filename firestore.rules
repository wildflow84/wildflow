rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 내 프로필 (소속 space 기록)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /spaces/{spaceId} {
      function isMember() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
      }

      // spaceId 자체가 비밀 초대 코드. 목록 조회(list)는 막고, 단건 get만 허용.
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // 구성원 목록(members)과 내보낸 사람(banned)은 서버 함수와 '참여'로만 바뀐다:
      //  - 멤버는 이름표 같은 다른 필드만 고칠 수 있다 (members/banned는 그대로)
      //  - 참여: 본인을 추가하고 총 2명 이하, 방장이 내보낸 사람(banned)은 불가
      allow update: if signedIn()
        && (
          (
            isMember()
            && request.resource.data.members == resource.data.members
            && request.resource.data.get('banned', []) == resource.data.get('banned', [])
          )
          || (
            !(request.auth.uid in resource.data.members)
            && !(request.auth.uid in resource.data.get('banned', []))
            && request.resource.data.get('banned', []) == resource.data.get('banned', [])
            && resource.data.members.size() < 2
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
          )
        );

      // 임시공휴일 등 공용 달력 정보: 멤버 모두 읽고 쓴다.
      match /holidays/{holidayId} {
        allow read, write: if isMember();
      }

      // 카테고리 정의는 공간 공용: 멤버 모두 읽고 쓴다.
      match /categories/{categoryId} {
        allow read, write: if isMember();
      }

      // 일정 구독(.ics 주소): 멤버 모두. 실제 동기화는 서버 함수가 한다.
      match /subscriptions/{subId} {
        allow read, write: if isMember();
      }

      match /items/{itemId} {
        // 공유 항목은 멤버 모두, 프라이빗은 소유자만 읽을 수 있다.
        allow read: if isMember()
          && (resource.data.visibility == 'shared' || resource.data.ownerUid == request.auth.uid);

        allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;

        // 수정: 소유자는 모두 가능. 같이 보기(shared) 항목은 상대도 고칠 수 있지만
        // 소유자와 공개 범위는 바꿀 수 없다. (공개 범위 변경으로 상대 항목이 사라지는 것을 막음)
        allow update: if isMember() && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid)
          || (resource.data.visibility == 'shared'
            && request.resource.data.visibility == 'shared'
            && request.resource.data.ownerUid == resource.data.ownerUid)
        );

        // 삭제는 소유자만
        allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
